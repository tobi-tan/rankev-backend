# --- Server ---
PORT=3000
NODE_ENV=development

# --- Database (PostgreSQL 15) ---
# Format: postgres://USER:PASSWORD@HOST:PORT/DATABASE
# Trên Railway: dùng biến DATABASE_URL mà Postgres plugin tự sinh.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/rankev

# --- Auth ---
# Secret ký access JWT. Dùng chuỗi ngẫu nhiên dài trong production.
# (Refresh token là opaque + hashed trong DB nên KHÔNG cần secret riêng.)
JWT_SECRET=change-me-to-a-long-random-secret
# Access token lifetime (vd 15m, 1h). Mặc định 15m.
ACCESS_TOKEN_TTL=15m
# Refresh token lifetime tính theo ngày. Mặc định 7.
REFRESH_TOKEN_TTL_DAYS=7

# --- CORS ---
# Danh sách origin cho phép (phân cách bằng dấu phẩy). Rỗng = cho phép tất cả (chỉ dev).
# Production: đặt domain frontend Vercel, vd: https://rankev.vercel.app
CORS_ORIGIN=

# --- Uploads: Cloudflare R2 (S3-compatible) ---
# Bỏ trống cả 5 biến = lưu ảnh vào local disk (dev). Railway có filesystem tạm thời
# nên PRODUCTION cần R2, nếu không ảnh sẽ mất mỗi lần redeploy.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=rankev-uploads
R2_PUBLIC_URL=
# Chỉ dùng khi lưu local ở production (không có R2): base URL công khai của backend,
# để dựng link ảnh tuyệt đối. Vd: https://rankev-api.up.railway.app
PUBLIC_BASE_URL=
